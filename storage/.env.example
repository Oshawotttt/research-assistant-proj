# Copy this to .env and fill in real values. Never commit .env.
# See ../SETUP.md for the values shared with the rest of the team.
#
# NOTE: keep comments on their own line, not after a value on the same line —
# Docker Compose's env_file parser does not strip inline comments, so
# "VAR=value  # comment" ends up with the comment baked into the value.

# --- Database (Storage Management's own `storage` schema) ---
# This is a JDBC URL. backend/.env uses a SQLAlchemy URL for the same server:
#   backend/   postgresql+asyncpg://user:pass@host:5432/postgres
#   storage/   jdbc:postgresql://host:5432/postgres  + user/password below
# Supabase: use the SESSION pooler (port 5432), not the transaction pooler.
# Local dev against backend/docker-compose.dev.yml is the default below.
DATABASE_URL=jdbc:postgresql://localhost:5432/research_assistant
DATABASE_USER=dev
DATABASE_PASSWORD=dev

# --- Auth ---
# base64 of 32+ random bytes, shared with User Management; decoded before use
JWT_SECRET=

# --- Service-to-service URLs ---
RE_BASE_URL=http://research-evaluation:8000
GROBID_URL=http://grobid:8070

# --- File storage ---
# Local disk for week 7, S3 later. Mounted as a Docker volume in the stack.
FILE_STORAGE_PATH=./files

# --- Local dev only ---
# The container always listens on 8080 and SM_BASE_URL points there, so leave
# this unset in Docker. It exists because User Management also defaults to
# 8080, and on the host only one service can have it.
SERVER_PORT=8081
